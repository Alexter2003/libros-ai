{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "prisma generate && nest build",
    "start:prod": "node dist/main.js",
    "typecheck": "prisma generate && tsc --noEmit",
    "prisma:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "db:seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1164.0",
    "@nestjs/common": "^12.4.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.4.0",
    "@nestjs/jwt": "^12.0.4",
    "@nestjs/platform-express": "^12.4.0",
    "@nestjs/swagger": "^12.1.1",
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "prisma": "^6.19.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.12",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "dotenv-cli": "^11.1.0",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
