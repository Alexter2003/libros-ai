# --- Database (local dev uses deploy/docker-compose.dev.yml) ---
POSTGRES_USER=libros
POSTGRES_PASSWORD=change-me
POSTGRES_DB=libros
DATABASE_URL=postgresql://libros:change-me@localhost:5432/libros

# --- API ---
PORT=3000
# Comma-separated list of allowed browser origins
WEB_ORIGIN=http://localhost:5173
# Auth: JWT_SECRET needs at least 32 characters (openssl rand -hex 32)
JWT_SECRET=change-me-change-me-change-me-change-me
JWT_EXPIRES_IN=8h
# First administrator, created on startup only when no admin exists
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# --- AWS Bedrock (AI gateway) ---
# Credentials of an IAM user limited to bedrock:InvokeModel on the chosen model.
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Model id of the default AI service created by the seed (e.g. a Nova Lite inference profile)
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0

# --- Web (Vite exposes only VITE_ variables) ---
VITE_API_URL=http://localhost:3000
