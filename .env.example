# --- Database (local dev uses deploy/docker-compose.dev.yml) ---
POSTGRES_USER=libros
POSTGRES_PASSWORD=change-me
POSTGRES_DB=libros
DATABASE_URL=postgresql://libros:change-me@localhost:5432/libros

# --- API ---
PORT=3000
# Comma-separated list of allowed browser origins
WEB_ORIGIN=http://localhost:5173
# Auth: JWT_SECRET needs at least 32 characters (openssl rand -hex 32)
JWT_SECRET=change-me-change-me-change-me-change-me
JWT_EXPIRES_IN=8h
# First administrator, created on startup only when no admin exists
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# --- Web (Vite exposes only VITE_ variables) ---
VITE_API_URL=http://localhost:3000
